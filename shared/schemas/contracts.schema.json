{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://exitzero.local/contracts.schema.json",
  "title": "ExitZero API contracts",
  "$ref": "#/$defs/BuildingScenario",
  "$defs": {
    "SpawnZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "count"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "BuildingScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "walls",
        "doors",
        "exits",
        "spawn_zones",
        "blocked_exit_ids",
        "obstructions",
        "agent_radius",
        "time_step_seconds",
        "seed",
        "max_steps"
      ],
      "properties": {
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "maxItems": 500
        },
        "doors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 1000
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 1000
        },
        "spawn_zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpawnZone"
          },
          "maxItems": 100
        },
        "blocked_exit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "obstructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        },
        "agent_radius": {
          "type": "number",
          "maximum": 2,
          "exclusiveMinimum": 0
        },
        "time_step_seconds": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "SimulationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_population",
        "evacuated",
        "trapped",
        "remaining",
        "clearance_steps"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "incomplete", "timeout"]
        },
        "total_population": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "evacuated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "trapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "clearance_steps": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "remaining": {
                "const": 0
              },
              "trapped": {
                "const": 0
              },
              "clearance_steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "else": {
            "properties": {
              "remaining": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "clearance_steps": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AgentPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        }
      }
    },
    "AnimationFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "agents"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentPosition"
          },
          "maxItems": 10000
        }
      }
    },
    "SimulationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_population",
        "evacuated",
        "trapped",
        "remaining",
        "clearance_steps",
        "frames",
        "width",
        "height",
        "traffic_samples",
        "time_step_seconds"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "incomplete", "timeout"]
        },
        "total_population": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "evacuated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "trapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "clearance_steps": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnimationFrame"
          }
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "traffic_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrafficSample"
          },
          "maxItems": 100000
        },
        "time_step_seconds": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "remaining": {
                "const": 0
              },
              "trapped": {
                "const": 0
              },
              "clearance_steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "else": {
            "properties": {
              "remaining": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "clearance_steps": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "StressTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_scenarios",
        "block_each_exit",
        "obstruction_candidates"
      ],
      "properties": {
        "max_scenarios": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "block_each_exit": {
          "type": "boolean"
        },
        "obstruction_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        }
      }
    },
    "StressTestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "config"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "config": {
          "$ref": "#/$defs/StressTestConfig"
        }
      }
    },
    "ScenarioModifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked_exit_ids", "added_obstructions"],
      "properties": {
        "blocked_exit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "added_obstructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        }
      }
    },
    "StressScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "description",
        "modifications",
        "metrics",
        "rank",
        "severity"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modifications": {
          "$ref": "#/$defs/ScenarioModifications"
        },
        "metrics": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "severity": {
          "enum": ["low", "moderate", "high", "critical"]
        }
      }
    },
    "StressTestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "scenarios"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StressScenarioResult"
          },
          "maxItems": 100
        }
      }
    },
    "OptimizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "max_candidates"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "OptimizationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "metrics", "rank"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "metrics": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "OptimizationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidates"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptimizationCandidate"
          },
          "maxItems": 100
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "service"],
      "properties": {
        "status": {
          "const": "ok"
        },
        "service": {
          "const": "exitzero"
        }
      }
    },
    "ApiErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        }
      }
    },
    "Wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "thickness"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "thickness": {
          "type": "number",
          "maximum": 2,
          "exclusiveMinimum": 0
        }
      }
    },
    "Opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wall_id", "offset", "width"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "wall_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "offset": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        }
      }
    },
    "Obstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        }
      }
    },
    "TrafficSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "visits"],
      "properties": {
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "visits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  }
}
