{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://exitzero.local/contracts.schema.json",
  "title": "ExitZero API contracts",
  "$ref": "#/$defs/BuildingScenario",
  "$defs": {
    "SpawnZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "count"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        }
      }
    },
    "BuildingScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "walls",
        "doors",
        "exits",
        "spawn_zones",
        "blocked_exit_ids",
        "obstructions",
        "agent_radius",
        "time_step_seconds",
        "seed",
        "max_steps"
      ],
      "properties": {
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "maxItems": 500
        },
        "doors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 1000
        },
        "exits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 1000
        },
        "spawn_zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpawnZone"
          },
          "maxItems": 100
        },
        "blocked_exit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 1000
        },
        "obstructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        },
        "agent_radius": {
          "type": "number",
          "maximum": 2,
          "exclusiveMinimum": 0
        },
        "time_step_seconds": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "stair_areas": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/StairArea"
          }
        },
        "awareness": {
          "$ref": "#/$defs/AgentAwareness"
        },
        "opening_events": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/OpeningStateChange"
          }
        },
        "windows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/WindowOpening"
          }
        },
        "window_escape_context": {
          "$ref": "#/$defs/WindowEscapeContext"
        }
      }
    },
    "SimulationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_population",
        "evacuated",
        "trapped",
        "remaining",
        "clearance_steps"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "incomplete", "timeout"]
        },
        "total_population": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "evacuated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "trapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "clearance_steps": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "evacuated_by_route": {
          "$ref": "#/$defs/EvacuatedByRoute"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "remaining": {
                "const": 0
              },
              "trapped": {
                "const": 0
              },
              "clearance_steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "else": {
            "properties": {
              "remaining": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "clearance_steps": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AgentPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        }
      }
    },
    "CommunicationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "sender_id",
        "recipient_ids",
        "opening_id",
        "blocked"
      ],
      "properties": {
        "step": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "event_type": { "enum": ["discovery", "shared"] },
        "sender_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "recipient_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "opening_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "blocked": { "type": "boolean" }
      },
      "if": {
        "required": ["event_type"],
        "properties": { "event_type": { "const": "discovery" } }
      },
      "then": {
        "properties": { "recipient_ids": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "recipient_ids": { "type": "array", "minItems": 1 } }
      }
    },
    "AnimationFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "agents"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentPosition"
          },
          "maxItems": 10000
        },
        "blocked_opening_ids": {
          "type": "array",
          "maxItems": 2000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "window_states": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/WindowFrameState"
          }
        }
      }
    },
    "SimulationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "total_population",
        "evacuated",
        "trapped",
        "remaining",
        "clearance_steps",
        "frames",
        "width",
        "height",
        "traffic_samples",
        "time_step_seconds"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "incomplete", "timeout"]
        },
        "total_population": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "evacuated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "trapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "clearance_steps": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnimationFrame"
          }
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "traffic_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrafficSample"
          },
          "maxItems": 100000
        },
        "time_step_seconds": {
          "type": "number",
          "maximum": 1,
          "exclusiveMinimum": 0
        },
        "analytics": {
          "$ref": "#/$defs/SimulationAnalytics"
        },
        "communication_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommunicationEvent" }
        },
        "evacuated_by_route": {
          "$ref": "#/$defs/EvacuatedByRoute"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "remaining": {
                "const": 0
              },
              "trapped": {
                "const": 0
              },
              "clearance_steps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "else": {
            "properties": {
              "remaining": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "clearance_steps": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "StressTestConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_scenarios",
        "block_each_exit",
        "obstruction_candidates"
      ],
      "properties": {
        "max_scenarios": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "block_each_exit": {
          "type": "boolean"
        },
        "obstruction_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        }
      }
    },
    "StressTestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "config"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "config": {
          "$ref": "#/$defs/StressTestConfig"
        }
      }
    },
    "ScenarioModifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked_exit_ids", "added_obstructions"],
      "properties": {
        "blocked_exit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "added_obstructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Obstruction"
          },
          "maxItems": 100
        }
      }
    },
    "StressScenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "description",
        "modifications",
        "metrics",
        "rank",
        "severity"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modifications": {
          "$ref": "#/$defs/ScenarioModifications"
        },
        "metrics": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "severity": {
          "enum": ["low", "moderate", "high", "critical"]
        }
      }
    },
    "StressTestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "scenarios"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StressScenarioResult"
          },
          "maxItems": 100
        }
      }
    },
    "OptimizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "max_candidates"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "OptimizationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "metrics", "rank"],
      "properties": {
        "building": {
          "$ref": "#/$defs/BuildingScenario"
        },
        "metrics": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "OptimizationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidates"],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/SimulationMetrics"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptimizationCandidate"
          },
          "maxItems": 100
        }
      }
    },
    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "service"],
      "properties": {
        "status": {
          "const": "ok"
        },
        "service": {
          "const": "exitzero"
        }
      }
    },
    "ApiErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        }
      }
    },
    "Wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "thickness"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "thickness": {
          "type": "number",
          "maximum": 2,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        }
      }
    },
    "Opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wall_id", "offset", "width"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "wall_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "offset": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        }
      }
    },
    "Obstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        }
      }
    },
    "TrafficSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "visits"],
      "properties": {
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "visits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "AgentStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "distance_metres",
        "waiting_steps",
        "waiting_seconds",
        "elapsed_seconds",
        "evacuation_step",
        "evacuation_seconds",
        "exit_id",
        "route_found"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "distance_metres": {
          "type": "number",
          "minimum": 0,
          "description": "Actual accepted movement distance in metres, including detours."
        },
        "waiting_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "waiting_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Collision-rejected ticks times time_step_seconds; excludes occupants without routes."
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "evacuation_step": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "evacuation_seconds": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "exit_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64
        },
        "route_found": {
          "type": "boolean"
        },
        "escape_route": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/EscapeRoute"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evacuation_step": {
                "type": "null"
              }
            },
            "required": ["evacuation_step"]
          },
          "then": {
            "properties": {
              "evacuation_seconds": {
                "type": "null"
              },
              "exit_id": {
                "type": "null"
              },
              "escape_route": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "evacuation_seconds": {
                "type": "number"
              },
              "route_found": {
                "const": true
              }
            },
            "anyOf": [
              {
                "properties": {
                  "exit_id": {
                    "type": "string"
                  }
                }
              },
              {
                "required": ["escape_route"],
                "properties": {
                  "exit_id": {
                    "type": "null"
                  },
                  "escape_route": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/EscapeRoute"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "emergency_window"
                          }
                        },
                        "type": "object"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "SimulationAnalytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "simulated_seconds",
        "median_evacuation_seconds",
        "total_distance_metres",
        "total_waiting_seconds"
      ],
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/AgentStatistics"
          }
        },
        "simulated_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "median_evacuation_seconds": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100000,
          "description": "Median among evacuated occupants only, even on incomplete runs. Null if nobody evacuated."
        },
        "total_distance_metres": {
          "type": "number",
          "minimum": 0
        },
        "total_waiting_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "StairArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "y": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        },
        "orientation_degrees": {
          "type": "integer",
          "enum": [0, 90, 180, 270]
        }
      }
    },
    "SimulationStreamEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "frame"],
          "properties": {
            "type": {
              "const": "frame"
            },
            "frame": {
              "$ref": "#/$defs/AnimationFrame"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "result"],
          "properties": {
            "type": {
              "const": "complete"
            },
            "result": {
              "$ref": "#/$defs/SimulationResult"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "error"],
          "properties": {
            "type": {
              "const": "error"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "AgentAwareness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sight_range_metres", "communication_range_metres"],
      "properties": {
        "sight_range_metres": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "communication_range_metres": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "OpeningStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "opening_id", "blocked"],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999
        },
        "opening_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "blocked": {
          "type": "boolean"
        }
      }
    },
    "WindowEscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "preparation",
        "clear_width_metres",
        "clear_height_metres",
        "preparation_seconds",
        "traversal_seconds",
        "exterior_side",
        "exterior_available"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "preparation": {
          "enum": ["open", "break"]
        },
        "clear_width_metres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "clear_height_metres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "preparation_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "traversal_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "exterior_side": {
          "enum": [-1, 1]
        },
        "exterior_available": {
          "type": "boolean"
        }
      }
    },
    "WindowOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wall_id", "offset", "width"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "wall_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "offset": {
          "type": "number",
          "maximum": 1000,
          "minimum": 0
        },
        "width": {
          "type": "number",
          "maximum": 1000,
          "exclusiveMinimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[^\\s\\u0085]",
          "description": "Optional user-facing display name. Stable object references continue to use id; names do not affect simulation."
        },
        "emergency_escape": {
          "$ref": "#/$defs/WindowEscape"
        }
      }
    },
    "WindowEscapeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_elevation_metres",
        "all_agents_can_traverse",
        "required_clear_height_metres"
      ],
      "properties": {
        "floor_elevation_metres": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "all_agents_can_traverse": {
          "type": "boolean"
        },
        "required_clear_height_metres": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "WindowFrameState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "state",
        "preparation_ready_step",
        "queue_agent_ids",
        "traversing_agent_id",
        "traversal_earliest_finish_step"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "state": {
          "enum": ["intact", "opening", "breaking", "open", "broken"]
        },
        "preparation_ready_step": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        },
        "queue_agent_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "traversing_agent_id": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        },
        "traversal_earliest_finish_step": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "EscapeRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "opening_id"],
      "properties": {
        "kind": {
          "enum": ["normal_exit", "emergency_window"]
        },
        "opening_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      }
    },
    "EvacuatedByRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal_exit", "emergency_window"],
      "properties": {
        "normal_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "emergency_window": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
